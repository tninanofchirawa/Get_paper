# ==============================================================================
# UNIFIED ACADEMIC PAPER HARVESTER, VERIFIER & 100% GMAIL PIPELINE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POLITE POOL & IDENTITY
# ------------------------------------------------------------------------------
# Polite pool email attached to Crossref & OpenAlex requests for accelerated bandwidth
POLITE_EMAIL=researcher@university.edu
RESEARCHER_EMAIL=researcher@university.edu
EMAIL_SENDER_NAME="Academic Paper Harvester Pipeline"

# ------------------------------------------------------------------------------
# 2. INSTITUTIONAL REPOSITORY API KEYS (BRANCH 1)
# ------------------------------------------------------------------------------
# Elsevier Scopus API (Mandatory: both key and inst token for campus/off-campus authoritative verification)
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=

# Clarivate Web of Science (WoS Expanded API Key)
WOS_API_KEY=

# IEEE Xplore REST API Key
IEEE_API_KEY=

# Optional Academic API Keys for elevated rate limits
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# ------------------------------------------------------------------------------
# 3. LOCAL MASTER JOURNAL DATABASES (BRANCH 2 OPEN ACCESS FALLBACK)
# ------------------------------------------------------------------------------
# Optional local offline ISSN title lists for O(1) Scopus/WoS match without token
SCOPUS_LOCAL_DB_PATH=data/scopus_source_list.xlsx
WOS_LOCAL_DB_PATH=data/wos_master_journal_list.csv

# ------------------------------------------------------------------------------
# 4. 100% FREE GMAIL SMTP DISPATCH & IMAP QUESTIONNAIRE LISTENER
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
RECIPIENT_EMAIL=researcher@university.edu

# Gmail SMTP Settings (Requires 16-character Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_USE_TLS=true

# Gmail IMAP Settings for Automated Questionnaire Response Reading
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx
IMAP_USE_SSL=true
IMAP_POLL_INTERVAL_SECONDS=120

# ------------------------------------------------------------------------------
# 5. GOOGLE DRIVE V3 DISPATCH & CLOUD SYNC
# ------------------------------------------------------------------------------
# Target folder ID in Google Drive where output .xlsx files are uploaded
GDRIVE_FOLDER_ID=1RAAhP5r2Ul0eNkDizDNfcIbB1azwwegT

# Path to Google Cloud Service Account JSON file
GDRIVE_SERVICE_ACCOUNT_JSON=service_account.json

# Optional: Direct JSON credentials string if running on cloud platforms (e.g. Heroku, Railway)
GDRIVE_SERVICE_ACCOUNT_RAW=

# ------------------------------------------------------------------------------
# 6. DIRECTORY & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DATABASE_PATH=data/pipeline.db
INPUT_DIR=input
OUTPUT_DIR=output
CACHE_DIR=cache
LOGS_DIR=logs
TEMP_DIR=temp
APP_TIMEZONE=Asia/Kolkata
