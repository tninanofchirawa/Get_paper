# ==============================================================================
# Hardened .gitignore for Unified Academic Paper Harvester & Verifier
# ==============================================================================

# 1. Virtual Environments (Decoupled from source repository)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 2. Environment Secrets & API Credentials
.env
.env.local
.env.*
!.env.example
service_account.json
credentials.json
credentials*.json
Credential.json
Credential*.json
token.json
Token.json

# 3. Spreadsheets & Data Exports (ignoring run outputs while preserving data templates and inputs)
output/*
!output/.gitkeep
storage/output/*
!storage/output/.gitkeep
*.csv
*.xlsx
*.xls
!data/scopus_source_list.xlsx
!data/wos_master_journal_list.csv
!input/*.csv
!storage/input/*.csv

# 4. Python Bytecode, Caches & Wheels
__pycache__/
*.py[cod]
*$py.class
*.whl
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# 5. Local Runtime Caches, Logs, and Temp runtime dumps
cache/*
!cache/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
.cache/
logs/*
!logs/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
temp/*
!temp/.gitkeep
storage/temp/*
!storage/temp/.gitkeep

# 6. SQLite Databases & WAL Journal Files
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
data/*.db
data/*.sqlite
data/*.db-wal
data/*.db-shm
!data/.gitkeep

# 7. OS & Editor Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
